@model OrganizationFormViewModel
@{
    ViewData["Title"] = "New organization";
}
<h1>New organization</h1>
<form method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="mb-3">
        <label asp-for="Slug" class="form-label"></label><input asp-for="Slug" class="form-control" /><span asp-validation-for="Slug" class="text-danger"></span>
        <div class="form-text">Immutable identifier sent by client applications in the <code>organization</code> parameter.</div>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
