@model Cerberus.Application.Common.PagedResult<OrganizationDto>
@{
    ViewData["Title"] = "Organizations";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Organizations</h1>
    <a class="btn btn-primary" asp-action="Create">New organization</a>
</div>
<form method="get" class="mb-3 d-flex gap-2">
    <input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Name or slug" />
    <button type="submit" class="btn btn-outline-secondary">Search</button>
</form>
<table class="table table-hover">
    <thead><tr><th>Name</th><th>Slug</th><th>Status</th><th>Created</th></tr></thead>
    <tbody>
        @foreach (var organization in Model.Items)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@organization.Id">@organization.Name</a></td>
                <td><code>@organization.Slug</code></td>
                <td>@organization.Status</td>
                <td>@organization.CreatedAt.ToString("yyyy-MM-dd")</td>
            </tr>
        }
    </tbody>
</table>
@{ var search = ViewData["Search"] as string; }
<partial name="_Pager" model="(Model.Page, Model.TotalPages, search)" />
