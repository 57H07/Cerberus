@model Cerberus.Application.Common.PagedResult<UserSummaryDto>
@{
    ViewData["Title"] = "Users";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Users</h1>
    <a class="btn btn-primary" asp-action="Create">New user</a>
</div>
<form method="get" class="mb-3 d-flex gap-2">
    <input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Login, email or name" />
    <button type="submit" class="btn btn-outline-secondary">Search</button>
</form>
<table class="table table-hover">
    <thead><tr><th>Login</th><th>Name</th><th>Email</th><th>Status</th></tr></thead>
    <tbody>
        @foreach (var user in Model.Items)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@user.Id">@user.UserName</a></td>
                <td>@user.FirstName @user.LastName</td>
                <td>@user.Email</td>
                <td>@user.Status</td>
            </tr>
        }
    </tbody>
</table>
@{ var search = ViewData["Search"] as string; }
<partial name="_Pager" model="(Model.Page, Model.TotalPages, search)" />
