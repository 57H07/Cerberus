@model ApplicationFormViewModel
@{
    ViewData["Title"] = "New application";
}
<h1>New application</h1>
<form method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div>
    <div class="mb-3">
        <label asp-for="OwnerOrganizationId" class="form-label"></label>
        <select asp-for="OwnerOrganizationId" class="form-select" asp-items="@(new SelectList(Model.Organizations, nameof(OrganizationDto.Id), nameof(OrganizationDto.Name)))"></select>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
</form>
