@model ClientSecretDto
@{
    ViewData["Title"] = "Client credentials";
}
<h1>Client credentials</h1>
<p>Client ID: <code>@Model.ClientId</code></p>
@if (Model.ClientSecret is not null)
{
    <div class="alert alert-warning">
        <p class="mb-2"><strong>Copy this secret now.</strong> It is stored hashed and will never be displayed again.</p>
        <code class="user-select-all">@Model.ClientSecret</code>
    </div>
}
else
{
    <p>This public client has no secret: it must use PKCE.</p>
}
<a class="btn btn-primary" asp-action="Details" asp-route-id="@ViewData["ApplicationId"]">Back to the application</a>
