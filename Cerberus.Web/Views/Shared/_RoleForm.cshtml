@model RoleFormViewModel
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <input asp-for="Description" class="form-control" />
    </div>
    <fieldset class="mb-3">
        <legend class="h6">Permissions</legend>
        @foreach (var permission in Model.AvailablePermissions)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="Permissions" value="@permission.Code" id="perm-@permission.Code"
                       checked="@Model.Permissions.Contains(permission.Code)" />
                <label class="form-check-label" for="perm-@permission.Code"><code>@permission.Code</code> - @permission.Description</label>
            </div>
        }
        <div class="form-text">You can only grant permissions you hold yourself.</div>
    </fieldset>
    <button type="submit" class="btn btn-primary">Save</button>
</form>
