@model IReadOnlyList<AuditEntryDto>
<table class="table table-sm table-striped">
    <thead><tr><th>Date (UTC)</th><th>Action</th><th>Outcome</th><th>Actor</th><th>Organization</th><th>Target</th><th>IP</th><th>Details</th></tr></thead>
    <tbody>
        @foreach (var entry in Model)
        {
            <tr>
                <td class="text-nowrap">@entry.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td><code>@entry.Action</code></td>
                <td>@entry.Outcome</td>
                <td><small>@entry.ActorUserId</small></td>
                <td><small>@entry.OrganizationId</small></td>
                <td><small>@entry.TargetType @entry.TargetId</small></td>
                <td>@entry.IpAddress</td>
                <td><small class="text-break">@entry.Details</small></td>
            </tr>
        }
    </tbody>
</table>
