@model InvitationViewModel
@{
    ViewData["Title"] = "Invitation";
}
<div class="card auth-card">
    <div class="card-body">
        @if (!Model.Invitation.IsValid)
        {
            <h1 class="h4 text-danger">Invalid invitation</h1>
            <p>This invitation is invalid, has expired or was already used.</p>
        }
        else
        {
            <h1 class="h4">Join @Model.Invitation.OrganizationName</h1>
            <p>This invitation was sent to <strong>@Model.Invitation.Email</strong>.</p>
            @if (Model.IsAuthenticated)
            {
                <form asp-action="AcceptInvitation" method="post">
                    <input type="hidden" name="token" value="@Model.Token" />
                    <button type="submit" class="btn btn-primary w-100">Accept the invitation</button>
                </form>
                <p class="form-text mt-2">The invitation can only be accepted by the account using this email address.</p>
            }
            else if (Model.Invitation.AccountExists)
            {
                <a class="btn btn-primary w-100" asp-action="Login" asp-route-returnUrl="@Url.Action("Invitation", new { token = Model.Token })">Sign in to accept</a>
            }
            else
            {
                <a class="btn btn-primary w-100" asp-action="Register" asp-route-token="@Model.Token">Create my account</a>
            }
        }
    </div>
</div>
